<Window x:Class="MandanHeat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MandanHeat.Controls"
        Title="MandanHeat · Ajustes"
        Width="760" Height="820" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        Icon="pack://application:,,,/Assets/MandanHeat.ico">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SlantButton}" />
        <Style TargetType="c:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="190" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,16,22,22">

            <!-- ============ General ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SettingsHeader}" />
                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,6"><TextBlock Text="Iniciar con Windows (como administrador, sin aviso de UAC)" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox Content="Iniciar minimizado en la bandeja" IsChecked="{Binding StartMinimized}" Margin="0,0,0,6" />
                    <CheckBox Content="Al cerrar con la X, seguir funcionando en la bandeja (junto al reloj)" IsChecked="{Binding CloseToTray}" Margin="0,0,0,6" />
                    <CheckBox Content="Minimizar a la bandeja del sistema" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,10" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Actualizar la ventana cada" Style="{StaticResource SettingLabel}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Ui" Content="0,5 s" IsChecked="{Binding Ui500}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Ui" Content="1 s" IsChecked="{Binding Ui1000}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Ui" Content="2 s" IsChecked="{Binding Ui2000}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Ahorro automático: con la ventana minimizada no se dibuja la interfaz, se activa el modo eficiencia de Windows y solo se leen los sensores que usen el overlay o el registro. Sin overlay ni registro, no se lee nada." />
                </StackPanel>
            </Border>

            <!-- ============ Atajos ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Atajos de teclado (funcionan dentro del juego)" Style="{StaticResource SettingsHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mostrar / ocultar overlay" Style="{StaticResource SettingLabel}" />
                        <c:HotkeyBox Grid.Row="0" Grid.Column="1" Hotkey="{Binding OverlayHotkey}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="Iniciar / detener registro" Style="{StaticResource SettingLabel}" />
                        <c:HotkeyBox Grid.Row="1" Grid.Column="1" Hotkey="{Binding LogHotkey}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="Mostrar / ocultar ventana" Style="{StaticResource SettingLabel}" />
                        <c:HotkeyBox Grid.Row="2" Grid.Column="1" Hotkey="{Binding WindowHotkey}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Haz clic en una caja y pulsa la combinación. Retroceso la desactiva. Se aplican al cerrar esta ventana." />
                </StackPanel>
            </Border>

            <!-- ============ Overlay ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Overlay" Style="{StaticResource SettingsHeader}" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Posición" Style="{StaticResource SettingLabel}" Width="80" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Corner" Content="↖" ToolTip="Arriba a la izquierda" IsChecked="{Binding PosTopLeft}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Corner" Content="↗" ToolTip="Arriba a la derecha" IsChecked="{Binding PosTopRight}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Corner" Content="↙" ToolTip="Abajo a la izquierda" IsChecked="{Binding PosBottomLeft}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Corner" Content="↘" ToolTip="Abajo a la derecha" IsChecked="{Binding PosBottomRight}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Tamaño" Style="{StaticResource SettingLabel}" Width="80" />
                        <Slider Width="220" Minimum="0.7" Maximum="2" SmallChange="0.05" LargeChange="0.1" Value="{Binding OverlayScale}" />
                        <TextBlock Text="{Binding OverlayScale, StringFormat={}{0:P0}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Fondo" Style="{StaticResource SettingLabel}" Width="80" />
                        <Slider Width="220" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding OverlayOpacity}" />
                        <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Mostrar" Style="{StaticResource SettingLabel}" Width="80" />
                        <CheckBox Content="FPS" IsChecked="{Binding ShowFps}" />
                        <CheckBox Content="CPU" IsChecked="{Binding ShowCpu}" />
                        <CheckBox Content="GPU" IsChecked="{Binding ShowGpu}" />
                        <CheckBox Content="Líquido y ventiladores" IsChecked="{Binding ShowLiquid}" />
                        <CheckBox Content="RAM" IsChecked="{Binding ShowRam}" />
                        <CheckBox Content="Indicador REC" IsChecked="{Binding ShowRec}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Marca la casilla junto a cualquier sensor de la ventana principal para añadirlo también. Funciona en juegos en ventana o pantalla completa sin bordes." />
                </StackPanel>
            </Border>

            <!-- ============ FPS ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Medición de FPS" Style="{StaticResource SettingsHeader}" />
                    <RadioButton GroupName="Fps" IsChecked="{Binding FpsAuto}" Margin="0,0,0,4"><TextBlock Text="Automático: PresentMon (FPS, frametime y 1 % low del juego en primer plano) y, si no hay datos, el driver" TextWrapping="Wrap" /></RadioButton>
                    <RadioButton GroupName="Fps" IsChecked="{Binding FpsPresentMon}" Margin="0,0,0,4" Content="Solo PresentMon" />
                    <RadioButton GroupName="Fps" IsChecked="{Binding FpsDriver}" Margin="0,0,0,4"><TextBlock Text="Solo el contador del driver de la GPU (igual que Adrenalin / HWiNFO «Cuadros por segundo»; consumo mínimo)" TextWrapping="Wrap" /></RadioButton>
                    <RadioButton GroupName="Fps" IsChecked="{Binding FpsOff}" Content="Desactivado" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Si usas AMD Fluid Motion Frames (AFMF), los fotogramas generados por el driver solo los cuenta el contador del driver. PresentMon solo se ejecuta mientras se muestran o registran FPS." />
                </StackPanel>
            </Border>

            <!-- ============ Registro ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Registro de métricas" Style="{StaticResource SettingsHeader}" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Carpeta" Style="{StaticResource SettingLabel}" Width="80" />
                        <Button DockPanel.Dock="Right" Content="Abrir" Command="{Binding OpenLogFolderCommand}" Margin="6,0,0,0" Padding="12,4" />
                        <Button DockPanel.Dock="Right" Content="Cambiar…" Command="{Binding BrowseLogFolderCommand}" Margin="8,0,0,0" Padding="12,4" />
                        <TextBox Text="{Binding LogFolder, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Una fila cada" Style="{StaticResource SettingLabel}" Width="110" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="LogInt" Content="0,5 s" IsChecked="{Binding Log500}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="LogInt" Content="1 s" IsChecked="{Binding Log1000}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="LogInt" Content="2 s" IsChecked="{Binding Log2000}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="LogInt" Content="5 s" IsChecked="{Binding Log5000}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Duración" Style="{StaticResource SettingLabel}" Width="110" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Dur" Content="Hasta detenerlo" IsChecked="{Binding DurManual}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Dur" Content="15 min" IsChecked="{Binding Dur15}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Dur" Content="30 min" IsChecked="{Binding Dur30}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Dur" Content="1 h" IsChecked="{Binding Dur60}" />
                        <RadioButton Style="{StaticResource Pill}" GroupName="Dur" Content="2 h" IsChecked="{Binding Dur120}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding LogAllSensors}" Margin="0,0,0,6"><TextBlock Text="Registrar todos los sensores (frecuencias, voltajes…). Si no, solo temperaturas, uso, ventiladores y potencia" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{Binding LogWriteSummary}" Margin="0,0,0,6"><TextBlock Text="Guardar un resumen (mín / media / máx, FPS medios, 1 % y 0,1 % low) al terminar" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{Binding LogExcelFormat}" Margin="0,0,0,6"><TextBlock Text="Formato para Excel en español (separador ; y coma decimal)" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{Binding LogAutoStart}" Margin="0,0,0,6"><TextBlock Text="Iniciar el registro automáticamente al jugar y detenerlo al cerrar el juego" TextWrapping="Wrap" /></CheckBox>
                    <TextBlock Text="Programas que no cuentan como juego (separados por comas):" Style="{StaticResource Muted}" Margin="28,0,0,4" />
                    <TextBox Text="{Binding ExcludedApps, UpdateSourceTrigger=LostFocus}" Margin="28,0,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Los archivos se llaman «Juego_fecha_hora.csv» con columnas Date, Time y «Sensor [unidad]», como los de HWiNFO. Se escriben a disco cada 10 s." />
                </StackPanel>
            </Border>

            <!-- ============ Refrigeración y sensores ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Refrigeración y sensores" Style="{StaticResource SettingsHeader}" />
                    <TextBlock Text="Ventiladores del radiador (se muestran con la temperatura del líquido):" Style="{StaticResource SettingLabel}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Fans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,4">
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Reading, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Si no aparecen los ventiladores de la placa, mira el aviso de la ventana principal o exporta el diagnóstico." />
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Selección automática" Command="{Binding ResetRadiatorCommand}" Padding="12,4" Margin="0,0,8,6" />
                        <Button Content="{Binding CustomNamesText}" Command="{Binding ResetNamesCommand}" Padding="12,4" Margin="0,0,8,6" />
                        <Button Content="{Binding HiddenText}" Command="{Binding ShowHiddenCommand}" Padding="12,4" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Clic derecho sobre un sensor de la ventana principal para renombrarlo, ocultarlo o fijarlo en el overlay." />
                </StackPanel>
            </Border>

            <!-- ============ Diagnóstico ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diagnóstico" Style="{StaticResource SettingsHeader}" />
                    <WrapPanel>
                        <Button Content="Exportar informe de sensores" Command="{Binding ExportDiagnosticsCommand}" Padding="12,4" Margin="0,0,8,6" Style="{StaticResource AccentButton}" />
                        <Button Content="Reiniciar lectura de sensores" Command="{Binding ReopenSensorsCommand}" Padding="12,4" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DiagnosticText}" Style="{StaticResource Hint}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="El informe lista todos los sensores con su valor e identificador, y los chips detectados. Sirve para comparar con HWiNFO." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
