<Window x:Class="MandanHeat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MandanHeat"
        Icon="pack://application:,,,/Assets/MandanHeat.ico"
        Width="1220" Height="840" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SlantButton}" />

        <!-- Grupo de sensores (Temperaturas, Uso, Ventiladores...) dentro de una tarjeta de hardware -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Width="400" Margin="0,0,22,16">
                <DockPanel Margin="0,0,0,6">
                    <Polygon DockPanel.Dock="Left" Points="0,0 6,0 3,10 -3,10" Fill="{StaticResource FireVerticalBrush}"
                             VerticalAlignment="Center" Margin="3,0,8,0" />
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBrush}" FontSize="14"
                               FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed" FontWeight="Bold" />
                    <Border Height="1" Margin="10,1,0,0" VerticalAlignment="Center" Opacity="0.35" Background="{StaticResource FireBrush}" />
                </DockPanel>
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="★" Style="{StaticResource SectionLabel}" FontSize="11"
                               ToolTip="Marca la estrella para ver el sensor en la vista simple" />
                    <TextBlock Grid.Column="1" Text="OV" Style="{StaticResource SectionLabel}" FontSize="10"
                               ToolTip="Marca la casilla para mostrar el sensor en el overlay" />
                    <TextBlock Grid.Column="2" Text="SENSOR" Style="{StaticResource SectionLabel}" FontSize="10" />
                    <TextBlock Grid.Column="3" Text="ACTUAL" Style="{StaticResource SectionLabel}" FontSize="10" HorizontalAlignment="Right" Margin="0" />
                    <TextBlock Grid.Column="4" Text="MÍN" Style="{StaticResource SectionLabel}" FontSize="10" HorizontalAlignment="Right" Margin="0" />
                    <TextBlock Grid.Column="5" Text="MÁX" Style="{StaticResource SectionLabel}" FontSize="10" HorizontalAlignment="Right" Margin="0" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Sensors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Mostrar en la vista simple" IsCheckable="True" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}" />
                                        <MenuItem Header="Renombrar…" Command="{Binding RenameCommand}" />
                                        <MenuItem Header="Mostrar en el overlay" IsCheckable="True" IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" />
                                        <Separator />
                                        <MenuItem Header="Ocultar este sensor" Command="{Binding HideCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource StarBox}" IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                          Command="{Binding ToggleFavoriteCommand}" ToolTip="Mostrar en la vista simple" />
                                <CheckBox Grid.Column="1" Style="{StaticResource PinBox}"
                                          IsChecked="{Binding IsPinned, Mode=TwoWay}" ToolTip="Mostrar en el overlay" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" VerticalAlignment="Center" Foreground="#D9DAE0" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="14"
                                               FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed" FontWeight="Bold"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                    <ProgressBar Style="{StaticResource FireBar}" Margin="22,2,0,0"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Min}" Style="{StaticResource Muted}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Grid.Column="5" Text="{Binding Max}" Style="{StaticResource Muted}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,14,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Cabecera ================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/MandanHeat.png" Width="46" Height="46" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="#FF3A00" BlurRadius="22" ShadowDepth="0" Opacity="0.7" />
                    </Image.Effect>
                </Image>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MANDAN" FontFamily="{StaticResource DisplayFont}" FontStretch="Condensed"
                                   FontWeight="Bold" FontStyle="Oblique" FontSize="34" />
                        <TextBlock Text="HEAT" FontFamily="{StaticResource DisplayFont}" FontStretch="Condensed"
                                   FontWeight="Bold" FontStyle="Oblique" FontSize="34" Foreground="{StaticResource FireBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF2A00" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="TEMPERATURAS · USO · VENTILADORES · FPS" Style="{StaticResource SectionLabel}"
                               FontSize="11" Margin="2,-4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Todos los sensores" IsChecked="{Binding ShowAllSensors}" Margin="0,0,18,0"
                          Visibility="{Binding IsFullView, Converter={StaticResource BoolToVis}}"
                          ToolTip="Muestra también frecuencias, voltajes, datos, etc." />
                <TextBlock Text="VISTA" Style="{StaticResource SectionLabel}" />
                <RadioButton Style="{StaticResource Pill}" GroupName="View" Content="SIMPLE" IsChecked="{Binding IsSimpleView}"
                             ToolTip="Solo las métricas básicas o las que elijas con ★" />
                <RadioButton Style="{StaticResource Pill}" GroupName="View" Content="COMPLETA" IsChecked="{Binding IsFullView}"
                             ToolTip="Todos los sensores de cada componente" />
            </StackPanel>
        </DockPanel>

        <!-- ================= Avisos ================= -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Banners}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1A0A0D" BorderBrush="#5A1820" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="{StaticResource FireVerticalBrush}" CornerRadius="3,0,0,3" />
                            <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Command="{Binding Action}"
                                    Style="{StaticResource AccentButton}" Margin="14,8,14,8" VerticalAlignment="Center"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Text}" Foreground="#FFC9A8" FontSize="13" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="14,10,0,10" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================= Resumen ================= -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" Margin="-6,0,-6,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,0">
                        <Border Style="{StaticResource Card}" Padding="16,14,16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Foreground="#C7C9D1" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="48"
                                               FontFamily="{StaticResource DisplayFont}" FontStretch="Condensed" FontWeight="Bold"
                                               Typography.NumeralAlignment="Tabular">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="{Binding Brush.Color}" BlurRadius="20" ShadowDepth="0" Opacity="0.55" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Unit}" Foreground="{StaticResource MutedBrush}" FontSize="18"
                                               FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed" FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" Margin="4,0,0,11" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Detail}" Margin="0,-2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FireStripe}" Margin="1,1,1,0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================= Barra de herramientas ================= -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,10">
            <DockPanel LastChildFill="False">
                <CheckBox DockPanel.Dock="Left" Style="{StaticResource FireToggle}" IsChecked="{Binding OverlayEnabled}" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="14">
                        <Run Text="OVERLAY EN JUEGO" />
                        <Run Text="{Binding OverlayHotkeyText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                </CheckBox>
                <Rectangle DockPanel.Dock="Left" Width="1" Height="24" Fill="{StaticResource CardBorderBrush}" Margin="18,0,18,0" />
                <Button DockPanel.Dock="Left" Content="{Binding LogButtonText}" Command="{Binding ToggleLoggingCommand}"
                        Style="{StaticResource RecordButton}" MinWidth="190" ToolTip="{Binding LogHotkeyText}" />
                <Button DockPanel.Dock="Left" Content="CARPETA DE REGISTROS" Command="{Binding OpenLogFolderCommand}" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Content="⚙  AJUSTES" Click="OnSettingsClick" Style="{StaticResource AccentButton}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
        <!-- ================= Sensores por componente ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsFullView, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Hardware}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,6,12">
                                <Border Style="{StaticResource Card}" Padding="20,14,16,4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Grid VerticalAlignment="Center">
                                                <Border Background="{StaticResource FireBrush}" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform><SkewTransform AngleX="-14" /></Border.RenderTransform>
                                                </Border>
                                                <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed"
                                                           FontSize="11" FontWeight="Bold" Foreground="#120604" Margin="9,2" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed"
                                                       FontSize="19" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <!-- Barra vertical de fuego a la izquierda -->
                                <Border Width="3" HorizontalAlignment="Left" Margin="1" Background="{StaticResource FireVerticalBrush}" CornerRadius="3,0,0,3" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        <!-- ================= Vista simple ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSimpleView, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,2,0,10" LastChildFill="False">
                        <Polygon DockPanel.Dock="Left" Points="0,0 7,0 3.5,12 -3.5,12" Fill="{StaticResource FireVerticalBrush}"
                                 VerticalAlignment="Center" Margin="4,0,10,0" />
                        <TextBlock DockPanel.Dock="Left" Text="MIS MÉTRICAS" FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,2,0,0"
                                   Text="Clic derecho en una ficha para quitarla · añade más con ★ en la vista completa" />
                        <Button DockPanel.Dock="Right" Content="RESTABLECER" Command="{Binding ResetSimpleViewCommand}" Margin="8,0,0,0"
                                ToolTip="Volver a las métricas básicas" />
                        <Button DockPanel.Dock="Right" Content="＋ AÑADIR MÉTRICAS" Command="{Binding AddMetricsCommand}"
                                Style="{StaticResource AccentButton}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SimpleSensors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="272" Margin="0,0,12,12">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Quitar de la vista simple" Command="{Binding ToggleFavoriteCommand}" />
                                            <MenuItem Header="Renombrar…" Command="{Binding RenameCommand}" />
                                            <MenuItem Header="Mostrar en el overlay" IsCheckable="True" IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Border Style="{StaticResource Card}" Padding="14,12,14,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Border Background="{StaticResource FireBrush}" RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform><SkewTransform AngleX="-14" /></Border.RenderTransform>
                                                    </Border>
                                                    <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource DisplayFont}" FontStretch="SemiCondensed"
                                                               FontSize="9" FontWeight="Bold" Foreground="#120604" Margin="6,1" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="#C7C9D1" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="32" Margin="0,4,0,2"
                                                       FontFamily="{StaticResource DisplayFont}" FontStretch="Condensed" FontWeight="Bold"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <ProgressBar Style="{StaticResource FireBar}" Margin="0,0,0,6" Value="{Binding Percent, Mode=OneWay}"
                                                         Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                <Run Text="mín" /> <Run Text="{Binding Min, Mode=OneWay}" Foreground="#B5B8C2" />
                                                <Run Text="  ·  máx" /> <Run Text="{Binding Max, Mode=OneWay}" Foreground="#B5B8C2" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FireStripe}" Margin="1,1,1,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Barra de estado ================= -->
        <TextBlock Grid.Row="5" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="2,8,0,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
