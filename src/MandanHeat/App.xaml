<Application x:Class="MandanHeat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tema Fluent oscuro de Windows 11 incluido en WPF (.NET 9+) como base de los controles -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Color de acento del tema Fluent (casillas, deslizadores, foco) → naranja fuego en vez del azul de Windows -->
            <Color x:Key="SystemAccentColor">#FF4A1C</Color>
            <Color x:Key="SystemAccentColorLight1">#FF6A3A</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8A5C</Color>
            <Color x:Key="SystemAccentColorLight3">#FFAE85</Color>
            <Color x:Key="SystemAccentColorDark1">#E03A10</Color>
            <Color x:Key="SystemAccentColorDark2">#B82C0A</Color>
            <Color x:Key="SystemAccentColorDark3">#8C2006</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF6A3A" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF6A3A" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF6A3A" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFAE85" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFAE85" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF8A5C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#120604" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF6A3A" />

            <!-- ===================== Paleta "fuego" ===================== -->
            <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>
            <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>

            <Color x:Key="FireYellow">#FFB300</Color>
            <Color x:Key="FireOrange">#FF5A00</Color>
            <Color x:Key="FireRed">#FF1E3C</Color>

            <SolidColorBrush x:Key="BgBrush" Color="#07070A" />
            <SolidColorBrush x:Key="CardBrush" Color="#0F0F14" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2A1518" />
            <SolidColorBrush x:Key="TextBrush" Color="#F3F3F6" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8B8F9C" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF4A1C" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FF4A1C" />
            <SolidColorBrush x:Key="HotBrush" Color="#FF1E3C" />
            <SolidColorBrush x:Key="TrackBrush" Color="#1D1D24" />

            <LinearGradientBrush x:Key="FireBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource FireYellow}" Offset="0" />
                <GradientStop Color="{StaticResource FireOrange}" Offset="0.5" />
                <GradientStop Color="{StaticResource FireRed}" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="FireVerticalBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource FireYellow}" Offset="0" />
                <GradientStop Color="{StaticResource FireOrange}" Offset="0.45" />
                <GradientStop Color="{StaticResource FireRed}" Offset="1" />
            </LinearGradientBrush>

            <!-- Fondo de ventana: negro con resplandor rojo arriba a la derecha y abajo a la izquierda -->
            <DrawingBrush x:Key="WindowBackground" Stretch="Fill">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#07070A">
                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush Center="100,0" GradientOrigin="100,0" RadiusX="70" RadiusY="55" MappingMode="Absolute">
                                    <GradientStop Color="#3AFF2A00" Offset="0" />
                                    <GradientStop Color="#00FF2A00" Offset="1" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush Center="0,100" GradientOrigin="0,100" RadiusX="60" RadiusY="45" MappingMode="Absolute">
                                    <GradientStop Color="#22FF0030" Offset="0" />
                                    <GradientStop Color="#00FF0030" Offset="1" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- Tarjeta: fondo con degradado, borde rojizo y franja de fuego arriba -->
            <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14141A" Offset="0" />
                <GradientStop Color="#0C0C10" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <!-- Franja superior de fuego (se coloca dentro de una tarjeta) -->
            <Style x:Key="FireStripe" TargetType="Border">
                <Setter Property="Height" Value="2" />
                <Setter Property="Background" Value="{StaticResource FireBrush}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="3,3,0,0" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Etiquetas en mayúsculas estilo "HUD" -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="SettingsHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>

            <!-- Casilla estándar con relleno de fuego -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="17" Height="17" CornerRadius="2" VerticalAlignment="Center"
                                        Background="#16161C" BorderBrush="#4A2A30" BorderThickness="1.3">
                                    <Path x:Name="Mark" Data="M 3 8.5 L 6.5 12 L 13.5 4" Stroke="#120604" StrokeThickness="2.4"
                                          Visibility="Collapsed" Margin="-0.5,-0.5,0,0" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource FireBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#FF7A3D" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Opción redonda con punto de fuego -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Ellipse x:Name="Ring" Fill="#16161C" Stroke="#4A2A30" StrokeThickness="1.4" />
                                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource FireBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="#FF7A3D" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Deslizador con pista de fuego -->
            <Style x:Key="SliderFill" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource FireBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SliderEmpty" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Height="4" CornerRadius="2" Background="#24242C" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Slider">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="24" Background="Transparent">
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="16" Height="16" Fill="White" Stroke="#FF5A00" StrokeThickness="3">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#FF3A00" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Barra de progreso fina con degradado de fuego -->
            <Style x:Key="FireBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="3" />
                <Setter Property="MinHeight" Value="3" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{StaticResource TrackBrush}" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource FireBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón en paralelogramo (base) -->
            <Style x:Key="SlantButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#16161C" />
                <Setter Property="BorderBrush" Value="#3A1D21" />
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><SkewTransform AngleX="-14" /></Border.RenderTransform>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón principal: relleno de fuego -->
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SlantButton}">
                <Setter Property="Background" Value="{StaticResource FireBrush}" />
                <Setter Property="BorderBrush" Value="#FF7A3D" />
                <Setter Property="Foreground" Value="#120604" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!-- Botón de grabación: rojo con brillo mientras graba -->
            <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource SlantButton}">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Background" Value="#1C0D10" />
                <Setter Property="BorderBrush" Value="#6E1A24" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLogging}" Value="True">
                        <Setter Property="Background" Value="#E0102E" />
                        <Setter Property="BorderBrush" Value="#FF5470" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#FF1E3C" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Opciones excluyentes en paralelogramo -->
            <Style x:Key="Pill" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontStretch" Value="SemiCondensed" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid MinWidth="38">
                                <Border x:Name="Bd" Background="#16161C" BorderBrush="#3A1D21" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><SkewTransform AngleX="-14" /></Border.RenderTransform>
                                </Border>
                                <ContentPresenter Margin="12,5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource FireBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A3D" />
                                    <Setter Property="Foreground" Value="#120604" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Interruptor (para el overlay) -->
            <Style x:Key="FireToggle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="42" Height="22" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="11" Background="#1D1D24" BorderBrush="#3A1D21" BorderThickness="1" />
                                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#8B8F9C" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                </Grid>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource FireBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#FF7A3D" />
                                    <Setter TargetName="Knob" Property="Fill" Value="White" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Estrella "mostrar en la vista simple" -->
            <Style x:Key="StarBox" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" Width="16" Height="16">
                                <Path x:Name="Star" Stretch="Uniform" Stroke="#4A3A3E" StrokeThickness="1.3" Fill="Transparent"
                                      Data="M 8,0.5 L 10.2,5.4 L 15.5,5.9 L 11.5,9.4 L 12.7,14.6 L 8,11.9 L 3.3,14.6 L 4.5,9.4 L 0.5,5.9 L 5.8,5.4 Z" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Star" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Star" Property="Fill" Value="{StaticResource FireVerticalBrush}" />
                                    <Setter TargetName="Star" Property="Stroke" Value="#FF7A3D" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Casilla pequeña "fijar en overlay" de cada sensor -->
            <Style x:Key="PinBox" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" Width="14" Height="14" CornerRadius="2"
                                    Background="Transparent" BorderBrush="#3A2A2E" BorderThickness="1.2">
                                <Path x:Name="Mark" Data="M 2.5 7 L 5.5 10 L 11 3.5" Stroke="#120604" StrokeThickness="2"
                                      Visibility="Collapsed" Margin="-1" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource FireBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A3D" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
