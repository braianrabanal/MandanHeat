<Window x:Class="MandanHeat.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        Icon="pack://application:,,,/Assets/MandanHeat.ico">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,10" />
        <TextBox x:Name="ValueBox" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Aceptar" IsDefault="True" Click="OnOk" Padding="18,5" Margin="0,0,8,0" Style="{StaticResource AccentButton}" />
            <Button Content="Cancelar" IsCancel="True" Padding="18,5" Style="{StaticResource SlantButton}" />
        </StackPanel>
    </StackPanel>
</Window>
